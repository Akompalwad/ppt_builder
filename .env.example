APP_ENV=development
AUTH_MODE=disabled
DATABASE_URL=sqlite:///./storage/presentations.db
REDIS_URL=redis://redis:6379/0
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=storage/files
LLM_PROVIDER=mock
ACCESS_GATE_ENABLED=true
ACCESS_MAX_ACTIVE_USERS=7
# A browser session releases its test slot after this many inactive minutes.
ACCESS_SESSION_TTL_MINUTES=60
# Create a key at https://build.nvidia.com, then set these values to enable NVIDIA.
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_SLIDE_BY_SLIDE_ENABLED=true
# Google AI Studio / Gemini API. Gemma 4 works well for structured slides.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TOKENS_PER_MINUTE=16000
GEMINI_REQUESTS_PER_MINUTE=30
GEMINI_QUEUE_MAX_WAIT_SECONDS=120
# One full deck at a time gives fair predictable usage with a shared key.
GENERATION_MAX_CONCURRENT_JOBS=1
OLLAMA_BASE_URL=http://localhost:11434/v1
# Run `ollama list`, then set one installed model here. Example: qwen2.5:7b
OLLAMA_MODEL=
OLLAMA_FALLBACK_ENABLED=false
OLLAMA_DEBUG_RESPONSES=false
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
IMAGE_PROVIDER=none
# Set IMAGE_PROVIDER=openai and these values to enable per-topic visual generation.
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
MAX_GENERATED_IMAGES_PER_DECK=3
FILE_RETENTION_HOURS=1
CLEANUP_INTERVAL_MINUTES=10
# Free Unsplash developer application alternative:
UNSPLASH_ACCESS_KEY=
UNSPLASH_BASE_URL=https://api.unsplash.com
